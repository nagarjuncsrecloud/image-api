terraform {
  required_providers {
    docker = {
      source  = "kreuzwerker/docker"
      version = "~> 3.0"
    }
  }
}

provider "docker" {}

resource "docker_image" "image_api" {
  name = "ghcr.io/nagarjuncsrecloud/image-api:latest"
}

resource "docker_container" "image_api" {
  image = docker_image.image_api.name
  name  = "image-api-container"
  ports {
    internal = 3301
    external = 3301
  }
}
